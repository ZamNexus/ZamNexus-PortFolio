OPENROUTER_API_KEY=
# optional, default anthropic/claude-haiku-4.5
OPENROUTER_MODEL=
# Where contact, demo, newsletter and chat leads are POSTed as JSON (Slack incoming webhook,
# Zapier/Make catch hook, Power Automate HTTP trigger or a CRM inbound URL). Required in production:
# without it leads only reach .leads.jsonl locally and the function logs on Vercel.
LEAD_WEBHOOK_URL=

# ── Admin panel (Insights CMS). Generate the values with:  node scripts/hash-password.mjs
# The admin panel stays switched off (sign-in returns 503) until all three are set.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# At least 32 random characters; signs the session cookie. Changing it signs every admin out.
ADMIN_SESSION_SECRET=
# ── Insights content storage. REQUIRED IN PRODUCTION ON VERCEL (its servers have no lasting disk).
# A Postgres connection string (Vercel marketplace: Neon or Supabase set DATABASE_URL/POSTGRES_URL for you;
# use the pooled one). CMS_DATABASE_URL wins if set. Without one, content is kept in ./data/cms.json.
CMS_DATABASE_URL=
# Vercel Blob read-write token, for article images (set for you when you connect a Blob store).
# Without it, images are kept in ./data/uploads. CMS_BLOB_ACCESS: "public" (default) or "private",
# matching the store's access setting.
BLOB_READ_WRITE_TOKEN=
CMS_BLOB_ACCESS=
# Optional, local file store only: where article data and uploaded images go (defaults below).
CMS_DATA_FILE=
CMS_UPLOADS_DIR=
